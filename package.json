{
	"name": "clearrun-global",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"dev:mock": "cf dev --mode mock",
		"build": "npm run knowledge:check && cf build",
		"build:mock": "npm run knowledge:check && cf build --mode mock",
		"deploy": "cf deploy",
		"knowledge": "node scripts/build-knowledge.ts",
		"knowledge:check": "node scripts/build-knowledge.ts --check",
		"typecheck": "cf workers types && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"cf": "^1.0.0-beta.19",
		"happy-dom": "^21.0.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"hono": "^4.13.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
}
